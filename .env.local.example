# Supabase project settings — from your Supabase project's API settings page
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-side only, NEVER exposed to the client.
# Used only in src/actions/clients.ts to create auth users for new clients.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL, used for password reset redirect links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
